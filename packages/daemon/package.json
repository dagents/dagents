{
  "name": "@dagents/daemon",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "bin": { "mil-daemon": "./dist/cli.js" },
  "exports": { ".": { "import": "./dist/index.js", "types": "./dist/index.d.ts" } },
  "scripts": {
    "dev": "tsx src/cli.ts",
    "build": "tsup src/main.ts src/cli.ts src/index.ts --format esm --dts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@dagents/contracts": "workspace:*",
    "@dagents/agent-adapters": "workspace:*",
    "@dagents/shared": "workspace:*"
  },
  "devDependencies": {
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.0.0",
    "vitest": "^2.0.0",
    "@types/node": "^20.0.0"
  }
}
