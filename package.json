{
  "name": "dagents",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --parallel --filter='!@dagents/daemon'",
    "dev:daemon": "tsx packages/daemon/src/cli.ts http://localhost:8081 dev-laptop claude",
    "dev:all": "scripts/dev.sh --with-daemon",
    "test": "turbo run test",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck"
  },
  "devDependencies": {
    "turbo": "^2.0.0",
    "typescript": "^5.5.0"
  }
}
