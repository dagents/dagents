{
  "name": "dagents",
  "private": true,
  "version": "0.1.0",
  "packageManager": "pnpm@10.26.0",
  "scripts": {
    "build": "node scripts/guard-build.mjs && turbo run build",
    "dev": "turbo run dev --parallel --filter='!@dagents/daemon'",
    "dev:daemon": "tsx packages/daemon/src/cli.ts http://localhost:8080 dev-laptop claude",
    "dev:all": "scripts/dev.sh --with-daemon",
    "test": "node scripts/guard-build.mjs && turbo run test",
    "lint": "turbo run lint --filter='!@dagents/agentflow'",
    "typecheck": "node scripts/guard-build.mjs && turbo run typecheck"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "turbo": "^2.10.12",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=22"
  }
}
