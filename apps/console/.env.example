# apps/console environment (M5a.1).
#
# Copy to .env.local for local dev. All values are read at runtime; none are
# inlined into the client bundle unless they are NEXT_PUBLIC_*.
#
# Gateway base URL. The console never dials backend services directly — every chat /
# prediction goes through the gateway (apps/gateway, default :8080), which
# rewrites /api/v1/flows/<id>/prediction → the workflow prediction path and
# threads x-run-id end-to-end. See docs/m2-canvas-e2e-verification.md.
GATEWAY_URL=http://localhost:8080

# Client-visible gateway origin (for the browser-side EventSource / fetch base).
# Defaults to the page origin so the browser calls back into Next's own API
# route proxy, which keeps the gateway URL server-side and avoids CORS.
# Override only when the browser should talk to the gateway directly.
# NEXT_PUBLIC_GATEWAY_URL=http://localhost:8080

# Default chatflow id used by the chat view when the agent selector's
# "prompt agent" has no explicit flow binding. The M1 demo chatflow
# is a reasonable default.
NEXT_PUBLIC_DEFAULT_FLOW_ID=d87207fd-7a11-4d42-8580-2f03ca58e79d
