{
  "name": "@dagents/gateway",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format esm",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@dagents/agent-adapters": "workspace:*",
    "@dagents/contracts": "workspace:*",
    "@dagents/db": "workspace:*",
    "@dagents/shared": "workspace:*",
    "@dagents/workflow": "workspace:*",
    "@hono/node-server": "^1.12.0",
    "hono": "^4.13.3",
    "ws": "^8.21.3",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/ws": "^8.5.0",
    "tsup": "^8.0.0",
    "tsx": "^4.23.12",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=22"
  }
}
