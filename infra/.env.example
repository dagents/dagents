# Mil-Agents local infrastructure environment variables.
# Copy to .env and override as needed. Defaults match docker-compose.yml.
#
# Host-side ports: the canonical service ports (new-api 3000, MinIO 9000/9001,
# Langfuse 3001) are bound as-is — they match the plan and the acceptance gates
# verbatim (`curl http://localhost:3000/api/status`, root/123456 on :3000). Only
# Postgres (5432) and Redis (6379) collide with other projects on this machine,
# so their host-side bindings are remapped by default; the in-network service
# ports stay canonical, so inter-container wiring (DSNs, mc host, depends_on) is
# unaffected. Override any of these back to the canonical value if the port is
# free on your host.

# ---- Postgres (shared by new-api + Langfuse) ----
POSTGRES_DB=milagents
POSTGRES_USER=milagents
POSTGRES_PASSWORD=milagents_dev
POSTGRES_HOST_PORT=15432
# Connection string from the HOST (your app on the host, not a container):
POSTGRES_URL=postgresql://milagents:milagents_dev@localhost:15432/milagents

# ---- Redis ----
REDIS_HOST_PORT=16479
REDIS_URL=redis://localhost:16479

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=milagents
MINIO_ROOT_PASSWORD=milagents_dev
MINIO_BUCKET=milagents
MINIO_API_HOST_PORT=9000
MINIO_CONSOLE_HOST_PORT=9001
# From the HOST: a full URL (scheme + host + port) — the S3 client
# (`@mil/repro` createS3ArtifactStore / scheduler createArtifactStoreFromEnv)
# reads `MINIO_ENDPOINT` verbatim as the endpoint URL, so it must include the
# scheme. Matches the production default `http://localhost:9000`.
MINIO_ENDPOINT=http://localhost:9000
MINIO_PORT=9000
MINIO_ACCESS_KEY=milagents
MINIO_SECRET_KEY=milagents_dev

# ---- new-api (LLM gateway) ----
NEWAPI_HOST_PORT=3000
NEWAPI_BASE_URL=http://localhost:3000
# Default web admin login: root / 123456 (set at first run via the UI).
# Provision an admin API key in the UI and paste it here for app use:
NEWAPI_ADMIN_KEY=

# ---- Langfuse (LLM observability) ----
# Pinned to v2.x in docker-compose.yml; v3 would require ClickHouse.
LANGFUSE_HOST_PORT=3001
LANGFUSE_BASE_URL=http://localhost:3001
# Generate real secrets for any non-dev environment:
#   openssl rand -hex 32
LANGFUSE_NEXTAUTH_SECRET=langfuse_dev_secret_change_me
LANGFUSE_SALT=langfuse_dev_salt_change_me
# Provision public/secret keys in the Langfuse UI and paste them here:
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ---- Flowise (vendored separately, not part of this compose stack) ----
FLOWISE_PORT=3100
# Base URL of the Flowise canvas editor the console embeds in an <iframe>
# (M0.3 / M2.3 前置). This is the iframe SRC; the matching CSP side lives on the
# Flowise server as IFRAME_ORIGINS (see vendor/flowise/packages/server/
# .env.mil-agents). Defaults to the vendored Flowise on :3100.
FLOWISE_EDITOR_URL=http://localhost:3100

# ---- Gateway SSO (M5b.4 / P1.4.T2 — dev mode) ----
# Dev-mode username/password login → HMAC-signed stateless session token.
# Generate a secret with: openssl rand -base64 48
# When all three are set, login is live; set REQUIRE_LOGIN=1 to gate every
# non-public gateway route behind a session. Leave unset for the open dev
# posture (no login). Prod SSO (OIDC) is a later task.
SSO_DEV_USERNAME=admin
SSO_DEV_PASSWORD=
SSO_SESSION_SECRET=
REQUIRE_LOGIN=
