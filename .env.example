# Mil-Agents application env (dev).
#
# Copy to `.env` and adjust. `scripts/dev.sh` sources `.env` before running
# turbo (turbo itself does NOT auto-load `.env` files, and the repo has no
# dotenv dependency — without this, a bare `pnpm dev` leaves these unset and
# the apps fall back to wrong ports / 503 "flowise api key not configured").
#
# `.env` is gitignored — safe for local overrides. Keep lines as simple
# `KEY=value` (no quotes, no `export`, no command substitution) so `source`
# parses them. Non-dev environments set these via the real env, not this file.
#
# Values mirror the `infra/docker-compose.yml` dev stack defaults + the
# vendored Flowise on :3101 (see CLAUDE.md). The only live credential here is
# FLOWISE_API_KEY — leave it blank; `scripts/dev.sh` auto-fetches it from the
# Flowise DB so it never has to be pasted into a file.

# ---- Postgres (host port remapped to 15432 to avoid :5432 collisions) ----
POSTGRES_URL=postgresql://milagents:milagents_dev@localhost:15432/milagents
DB_LOG=

# ---- Redis (host port remapped to 16479; dev stack runs with NO password) ----
REDIS_URL=redis://localhost:16479

# ---- MinIO (S3; repro archives run outputs + reproduce reports here) ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=milagents
MINIO_SECRET_KEY=milagents_dev
MINIO_BUCKET=milagents

# ---- new-api (LLM gateway) ----
# Default web admin: root / 123456. The compose default maps new-api to host
# :3000, which collides with the console (Next, :3000) — this host remaps it to
# :13000 (set via NEWAPI_HOST_PORT when the stack was brought up). Point the
# gateway at whichever port your stack actually exposes:
NEWAPI_BASE_URL=http://localhost:13000
# Provision an admin API key in the new-api UI and paste here for the probe
# worker (best-effort; blank = probe is a no-op, gateway still boots):
NEWAPI_ADMIN_KEY=
NEWAPI_ADMIN_USER_ID=1

# ---- Flowise (vendored separately, NOT in the compose stack) ----
# Start it: see scripts/dev-flowise.sh or CLAUDE.md. The vendored server's
# .env.mil-agents sets PORT=3101, so the gateway points here (NOT :3100).
FLOWISE_URL=http://localhost:3101
# Leave blank — scripts/dev.sh fetches it from the Flowise `apikey` table:
FLOWISE_API_KEY=
# Canvas editor URL the console embeds in an <iframe> (iframe SRC):
FLOWISE_EDITOR_URL=http://localhost:3101

# ---- Inter-app URLs (defaults match the app port defaults below) ----
GATEWAY_URL=http://localhost:8080
DISPATCH_URL=http://localhost:8081
SCHEDULER_URL=http://localhost:8082

# ---- App ports ----
GATEWAY_PORT=8080
DISPATCH_PORT=8081
SCHEDULER_PORT=8082

# ---- Gateway SSO (dev mode; leave REQUIRE_LOGIN unset for the open dev posture) ----
SSO_DEV_USERNAME=admin
SSO_DEV_PASSWORD=
SSO_SESSION_SECRET=
REQUIRE_LOGIN=

# ---- Scheduler tunables ----
SCHEDULER_MAX_CONCURRENT=10
SCHEDULER_RECOVER_ON_START=
TOKEN_PROBE_INTERVAL_MS=

# ---- Observability ----
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset in dev: Langfuse v2 does NOT expose
# OTLP ingestion (needs v3/ClickHouse or a collector), so pointing it at
# Langfuse v2 silently drops traces. Set only if you run a real collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_LOG_LEVEL=
LOG_LEVEL=info
