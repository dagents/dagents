# Mil-Agents application env (dev).
#
# Copy to `.env` and adjust. `scripts/dev.sh` sources `.env` before running
# turbo (turbo itself does NOT auto-load `.env` files, and the repo has no
# dotenv dependency — without this, a bare `pnpm dev` leaves these unset and
# the apps fall back to wrong ports).
#
# `.env` is gitignored — safe for local overrides. Keep lines as simple
# `KEY=value` (no quotes, no `export`, no command substitution) so `source`
# parses them. Non-dev environments set these via the real env, not this file.
#
# Values mirror the `infra/docker-compose.yml` dev stack defaults.

# ---- Postgres (host port remapped to 15432 to avoid :5432 collisions) ----
POSTGRES_URL=postgresql://dagents:dagents_dev@localhost:15432/dagents
DB_LOG=

# ---- Inter-app URLs (defaults match the app port defaults below) ----
GATEWAY_URL=http://localhost:8080

# ---- App ports ----
GATEWAY_PORT=8080

# ---- Security (REQUIRED for any non-localhost deployment) ----
# Generate with: openssl rand -hex 32  (all four should be DIFFERENT values)
# API key for programmatic gateway access (scripts, CI, curl)
GATEWAY_API_KEY=
# Token required to register new daemons (prevents rogue daemon injection)
DAEMON_REGISTER_TOKEN=
# AES-256-GCM key for encrypting LLM API keys at rest (64 hex chars = 32 bytes)
# Without this, API keys fall back to Base64 (reversible — NOT secure!)
ENCRYPTION_KEY=

# ---- Daemons ----

# ---- Observability ----
# OTLP exporter for service-level OTel traces. Leave unset in dev unless you
# run a real collector (Jaeger/Tempo): Langfuse v2 does NOT expose OTLP
# ingestion (needs v3/ClickHouse), so pointing this at Langfuse v2 silently
# drops traces.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_LOG_LEVEL=
LOG_LEVEL=info

# Langfuse workflow-run traces. Unlike OTLP, this path works against the
# pinned Langfuse v2: the gateway batches each workflow run's node spans and
# POSTs them to /api/public/ingestion (see packages/shared/src/langfuse.ts).
# Provision keys in the Langfuse UI (Settings → API Keys) and fill all three
# to activate; leaving any empty keeps the export off.
LANGFUSE_BASE_URL=http://localhost:3001
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
