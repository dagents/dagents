# Mil-Agents application env (dev).
#
# Copy to `.env` and adjust. `scripts/dev.sh` sources `.env` before running
# turbo (turbo itself does NOT auto-load `.env` files, and the repo has no
# dotenv dependency — without this, a bare `pnpm dev` leaves these unset and
# the apps fall back to wrong ports).
#
# `.env` is gitignored — safe for local overrides. Keep lines as simple
# `KEY=value` (no quotes, no `export`, no command substitution) so `source`
# parses them. Non-dev environments set these via the real env, not this file.
#
# Values mirror the `infra/docker-compose.yml` dev stack defaults.

# ---- Postgres (host port remapped to 15432 to avoid :5432 collisions) ----
POSTGRES_URL=postgresql://dagents:dagents_dev@localhost:15432/dagents
DB_LOG=

# ---- Inter-app URLs (defaults match the app port defaults below) ----
GATEWAY_URL=http://localhost:8080

# ---- App ports ----
GATEWAY_PORT=8080

# ---- Gateway SSO (dev mode; leave REQUIRE_LOGIN unset for the open dev posture) ----
SSO_DEV_USERNAME=admin
SSO_DEV_PASSWORD=
SSO_SESSION_SECRET=
REQUIRE_LOGIN=

# ---- Daemons ----
TOKEN_PROBE_INTERVAL_MS=

# ---- Observability ----
# Leave OTEL_EXPORTER_OTLP_ENDPOINT unset in dev: Langfuse v2 does NOT expose
# OTLP ingestion (needs v3/ClickHouse or a collector), so pointing it at
# Langfuse v2 silently drops traces. Set only if you run a real collector.
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_LOG_LEVEL=
LOG_LEVEL=info
