# Build artifacts
node_modules/
dist/
.next/
out/
build/

# Caches
.turbo/
.cache/
coverage/

# VCS + metadata
.git/
.gitignore
.github/

# Docs + scratch
*.md
docs/
*.log
.dev.pid
.codegraph/
.superpowers/

# Local env (never bake secrets into the image)
.env
.env.*
!.env.example

# Editor / OS noise
.DS_Store
.vscode/
.idea/
*.swp

# CI / e2e fixtures that shouldn't bloat the build context
packages/e2e/

# Desktop client staging (embedded PG binaries / bundled service stack) — desktop
# assets must never leak into service images (bfac702 lesson). Patterns here are
# root-anchored, so nested dirs need explicit entries.
apps/desktop/stage/
apps/desktop/release/
# console standalone 打包出口（NEXT_DIST_DIR 隔离产物；root-anchored 故需显式嵌套条目）
apps/console/.next-build/
