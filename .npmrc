auto-install-peers = true
strict-peer-dependencies = false
prefer-workspace-packages = true
link-workspace-packages = deep
hoist = true
shamefully-hoist = true
engine-strict = false
# ignore-scripts 历史上为 vendor/flowise 的 husky postinstall 而设（vendor 已删）；
# 保留是为防供应链 postinstall 意外执行 —— 有明确需要时再按包白名单放开。
ignore-scripts = true
