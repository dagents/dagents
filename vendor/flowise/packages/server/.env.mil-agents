# Flowise server config for mil-agents M1.1–M1.5.
# Points Flowise at the mil-agents shared Postgres + Redis, and sets the
# listening port. The LLM credential (new-api token) and the Langfuse credential
# (public/secret key + endpoint) are stored encrypted in the Flowise DB
# (see scripts/flowise-m1-setup.py and scripts/flowise-langfuse-setup.py),
# NOT in this file.
#
# This file is the documented default; the live copy used at runtime lives in
# the Flowise source tree (~/Projects/Flowise/packages/server/.env) which is
# outside this repo. Commit it here so the config is reproducible.
#
# Bring up the mil-agents stack first:
#   cd infra && docker compose up -d postgres redis new-api
# Create the flowise DB once:
#   docker exec mil-agents-postgres-1 psql -U milagents -d postgres -c \
#     "CREATE DATABASE flowise OWNER milagents;"
# Then start Flowise from the built fork:
#   cd vendor/flowise && pnpm exec flowise start
#   (or from ~/Projects/Flowise which shares the same commit bb773ffa)

# --- Server ---
PORT=3101

# --- Database (mil-agents shared Postgres, host-mapped 127.0.0.1:15432 -> 5432) ---
DATABASE_TYPE=postgres
DATABASE_HOST=127.0.0.1
DATABASE_PORT=15432
DATABASE_NAME=flowise
DATABASE_USER=milagents
DATABASE_PASSWORD=milagents_dev

# --- Redis (mil-agents shared Redis, host-mapped 127.0.0.1:16479 -> 6379) ---
# The shared Redis requires AUTH (requirepass, set in infra/docker-compose.yml as
# REDIS_AUTH, default milagents_dev). The password MUST be in the URL, not just
# REDIS_URL=redis://host:port — Flowise's BullMQ/RedisEvent clients pass the URL
# verbatim and NOAUTH → silent connection stalls on every prediction.
REDIS_URL=redis://default:milagents_dev@127.0.0.1:16479

# --- M3.3 multi-instance mode (Gate-2 §3/§4.3) ---
# MODE=queue turns Flowise into a horizontal-scale deployment: a prediction is
# enqueued as a BullMQ job, any worker instance with the same REDIS_URL picks it
# up, and SSE events ride Redis pub/sub back to the gateway instance that holds
# the client connection. With a shared PG (`execution`/`chat_message` tables) +
# shared Redis, two Flowise instances share the same run state — the M3.3
# acceptance bar. Requires a separately-started `flowise worker` per instance
# (the `start` process is the gateway/SSE bridge only; it does NOT consume the
# prediction queue itself in QUEUE mode).
MODE=queue

# --- Telemetry / noise ---
DISABLE_FLOWISE_TELEMETRY=true
LOG_LEVEL=info

# --- CORS (allow our own console later) ---
CORS_ORIGINS=*

# --- iframe embedding (M0.3 / M2.3 前置) ---
# Flowise reads IFRAME_ORIGINS in
# packages/server/src/utils/XSS.ts:getIframeSecurityHeaders() and emits it as
# the CSP `frame-ancestors` directive. Unset → 'self' + X-Frame-Options
# SAMEORIGIN, which blocks the console at :3000 from embedding the :3100
# canvas. Setting it to the console origin permits cross-origin iframe
# embedding so the console can host the Flowise canvas editor. Add more
# origins (comma-separated) for staging/prod as needed.
IFRAME_ORIGINS=http://localhost:3000

# --- Langfuse observability (M1.5) ---
# Flowise ships a built-in Langfuse analytics provider (vendor/flowise/packages/
# components/src/handler.ts, langfuse-langchain CallbackHandler). It is wired per
# chatflow, NOT via these env vars: Flowise does not read LANGFUSE_* env vars
# (only LangSmith has an env-var path, see components/src/tracingEnv.ts). The
# public/secret key + endpoint live in a `langfuseApi` Flowise credential, and the
# chatflow's `analytic` JSON field enables the provider on that chatflow.
#
# scripts/flowise-langfuse-setup.py provisions Langfuse (org/project/key/glm-5.2
# price), creates the `langfuseApi` credential, and flips the analytic flag on the
# M1 Agent Demo chatflow in one shot. Run it with FLOWISE_API_KEY set.
#
# LANGFUSE_BASE_URL is echoed here only as the endpoint the credential points at.
LANGFUSE_BASE_URL=http://localhost:3001
