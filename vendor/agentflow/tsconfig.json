{
    "compilerOptions": {
        "target": "ES2020",
        "lib": ["ES2020", "DOM", "DOM.Iterable"],
        "module": "ESNext",
        "moduleResolution": "bundler",
        "jsx": "react-jsx",
        "strict": true,
        "noEmit": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "resolveJsonModule": true,
        "isolatedModules": true,
        "declaration": true,
        "baseUrl": ".",
        "paths": {
            "@/*": ["./src/*"],
            "@test-utils/*": ["./src/__test_utils__/*"],
            "@agentflow/core": ["./src/core"],
            "@agentflow/core/*": ["./src/core/*"],
            "@agentflow/atoms": ["./src/atoms"],
            "@agentflow/atoms/*": ["./src/atoms/*"],
            "@agentflow/infrastructure": ["./src/infrastructure"],
            "@agentflow/infrastructure/*": ["./src/infrastructure/*"],
            "@agentflow/features": ["./src/features"],
            "@agentflow/features/*": ["./src/features/*"],
            "@agentflow/assets/*": ["./src/assets/*"],
            "@agentflow/canvas": ["./src/features/canvas"],
            "@agentflow/canvas/*": ["./src/features/canvas/*"]
        }
    },
    "include": ["src"],
    "exclude": ["node_modules", "dist"]
}
